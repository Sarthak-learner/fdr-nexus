# Copy to .env (never commit real secrets)
DATABASE_URL=
FDR_DATA_DIR=
MATURITY_WARNING_DAYS=60
MAX_UPLOAD_MB=5
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME=fdr_session
CSRF_COOKIE_NAME=fdr_csrf
# Set true when served over HTTPS. Keep false only for local HTTP development.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
# Optional one-time bootstrap. Set both before first startup; never commit them.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Only fill when AICTE grants you authorized API access. Leave blank otherwise.
AICTE_API_BASE=
AICTE_API_KEY=
